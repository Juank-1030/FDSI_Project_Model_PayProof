# ============================================================
# PayProof - plantilla de variables de entorno
# Copia este archivo como ".env" y rellena los valores reales.
# El archivo .env NUNCA se versiona (ver .gitignore).
# ============================================================

# Proveedor del agente de interpretación: local (modelo propio, sin API) | groq | ollama
LLM_PROVIDER=local
GROQ_API_KEY=TU_GROQ_API_KEY_AQUI
GROQ_MODEL=openai/gpt-oss-120b

# Core bancario FinAegis (ver README del core: https://github.com/FinAegis/core-banking-prototype-laravel)
FINAEGIS_BASE_URL=http://localhost:8000
FINAEGIS_EMAIL=demo.user@gcu.global
FINAEGIS_PASSWORD=demo123
# Opcional: UUID de la cuenta origen (si se deja vacío se usa la primera cuenta del usuario)
FINAEGIS_FROM_ACCOUNT=

# Monto (unidades de divisa) a partir del cual un pago requiere confirmación adicional
PAYPROOF_LARGE_AMOUNT=1000

# ------------------------------------------------------------
# Notificaciones de aprobación
# ------------------------------------------------------------
# Canal: mock (demo, se muestra en la app) | evolution | whatsapp_cloud
NOTIFY_PROVIDER=mock
NOTIFY_APPROVER=admin
# Número del aprobador (para evolution / whatsapp_cloud), ej. 573001234567
NOTIFY_APPROVER_NUMBER=

# Evolution API (docker: evoapicloud/evolution-api)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=TU_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=payproof

# WhatsApp Cloud API (oficial de Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Deep link de aprobación (debe ser alcanzable desde el teléfono: ngrok o IP LAN)
APPROVAL_LINK_BASE=http://localhost:8501
APPROVAL_TOKEN_TTL_MINUTES=60
APPROVAL_HMAC_SECRET=secreto-local-cambiar-en-produccion

# Biometría: mock (demo) | webauthn (passkey real en el navegador)
BIOMETRIC_PROVIDER=mock
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PayProof
WEBAUTHN_ORIGIN=http://localhost:8501

